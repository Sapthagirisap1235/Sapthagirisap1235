# Gemini Developer API (AI Studio) — NOT Vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# the live model + voice (NOT a TTS voice — the Live API has its own native voice set)
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Aoede
# JARVIS defaults to a different voice (Charon) — override here if you want another one.
# LIVE_VOICE=Charon

# optional — silences ADK OpenTelemetry chatter when running the ADK version (EP2)
OTEL_SDK_DISABLED=true

# used by adk/jarvis_tools.py's web_search tool (a separate, non-live Gemini call
# with Google Search grounding enabled) — defaults to a fast, cheap model
SEARCH_MODEL=gemini-flash-latest

# --- JARVIS auth + persistent memory (required for a public deployment) ---
# Single-user login. Pick your own values — these are NOT provided for you.
JARVIS_USERNAME=owner
JARVIS_PASSWORD=change-me-to-something-real
# A long random string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string
# Set to false only for local http://localhost testing. Leave true (default)
# for any real deployment — browsers won't send a "secure" cookie over plain http.
COOKIE_SECURE=true
# Where the conversation history lives. Default is a local sqlite file next to
# the app; point this at Postgres/MySQL if you deploy with a managed DB instead.
DB_URL=sqlite+aiosqlite:///./jarvis_memory.db

# --- Where this server runs (affects which tools make sense) ---
# true (default): running on the user's own computer — open_app, run_shell_command,
#   search_files, get_system_status act on the same machine the user is talking to.
# false: running on a remote server (Render, a VPS, etc.) — those four tools are
#   dropped entirely, since they'd otherwise act on the SERVER, not the user's device.
LOCAL_MODE=true

# --- YouTube search + embedded player (optional) ---
# Get one from console.cloud.google.com -> APIs & Services -> enable
# "YouTube Data API v3" -> Credentials -> Create API key. Without this set,
# youtube_search will tell JARVIS it can't search rather than failing silently.
YOUTUBE_API_KEY=
